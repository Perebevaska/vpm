[Unit]
# MVP1 — webdav-tunnel server (external WebDAV = Яндекс.Диск), egress в цепочку.
Description=webdav-tunnel server (Yandex Disk -> chain)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Впиши свои логин и пароль приложения Яндекса:
ExecStart=/usr/local/bin/webdav-tunnel \
  -mode server \
  -webdav https://webdav.yandex.ru \
  -login ТВОЙ_ЯНДЕКС_ЛОГИН \
  -password ПАРОЛЬ_ПРИЛОЖЕНИЯ \
  -enc \
  -proxy socks5://192.168.1.1:10800
Restart=on-failure
RestartSec=5
# Немного безопасности:
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
